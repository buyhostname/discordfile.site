{
  "name": "discordfile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "db:push": "dotenv -e .env -- npx prisma db push",
    "db:generate": "dotenv -e .env -- npx prisma generate",
    "db:studio": "dotenv -e .env -- npx prisma studio",
    "prisma:dev": "dotenv -e .env -- npx prisma",
    "prisma:prod": "dotenv -e .env.production -- npx prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "better-sqlite3": "^12.6.2",
    "better-sqlite3-session-store": "^0.1.0",
    "blurhash": "^2.0.5",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "dotenv-cli": "^7.3.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.3",
    "pug": "^3.0.2",
    "resend": "^6.9.1",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "prisma": "^5.8.0",
    "puppeteer": "^24.37.2"
  }
}
