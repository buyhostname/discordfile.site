extends layout

block content
  //- Header/Navbar
  header(class="sticky top-0 z-50 bg-black/90 backdrop-blur border-b border-neutral-800")
    div(class="container mx-auto max-w-6xl px-4 py-3 flex items-center justify-between")
      a(href="/" class="text-xl font-bold tracking-tight")
        span(class="text-white") Discord
        span(class="text-indigo-400") File
      
      div(class="flex items-center gap-4")
        a(href="/auth/discord" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-sm font-medium transition")
          | Creator Login

  //- Main content
  main(class="container mx-auto max-w-md px-4 py-16")
    div(class="bg-neutral-900 rounded-2xl p-8")
      h1(class="text-2xl font-bold mb-2 text-center") Enter your code
      p(class="text-neutral-400 text-center mb-8") 
        | We sent a 6-digit code to 
        span(class="text-white") #{maskedEmail}
      
      if error === 'wrong_code'
        div(class="bg-red-500/10 border border-red-500/20 rounded-lg px-4 py-3 mb-6")
          p(class="text-red-400 text-sm") Incorrect code. Please try again.
      
      if error === 'too_many_attempts'
        div(class="bg-red-500/10 border border-red-500/20 rounded-lg px-4 py-3 mb-6")
          p(class="text-red-400 text-sm") Too many failed attempts. Please request a new code.
      
      if error === 'invalid_token'
        div(class="bg-red-500/10 border border-red-500/20 rounded-lg px-4 py-3 mb-6")
          p(class="text-red-400 text-sm") Invalid or expired code. Please request a new one.
      
      if error !== 'too_many_attempts' && error !== 'invalid_token'
        form(method="POST" action="/auth/email/code" class="space-y-6")
          input(type="hidden" name="t" value=tokenId)
          
          div
            label(for="code" class="block text-sm font-medium text-neutral-300 mb-2") 6-Digit Code
            input#code(
              type="text" 
              name="code" 
              required 
              maxlength="6"
              minlength="6"
              pattern="[0-9]{6}"
              inputmode="numeric"
              autocomplete="one-time-code"
              placeholder="000000"
              class="w-full px-4 py-3 bg-neutral-800 border border-neutral-700 rounded-lg text-white text-center text-2xl tracking-widest placeholder-neutral-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
            )
          
          if attemptsRemaining !== undefined
            p(class="text-neutral-500 text-sm text-center")
              | #{attemptsRemaining} attempt#{attemptsRemaining !== 1 ? 's' : ''} remaining
          
          button(type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 rounded-lg font-medium transition")
            | Verify Code
        
        div(class="mt-6 text-center")
          a(href="/auth/email" class="text-neutral-400 hover:text-neutral-300 text-sm transition")
            | Request a new code
      else
        div(class="text-center")
          a(href="/auth/email" class="inline-flex items-center justify-center w-full py-3 bg-indigo-600 hover:bg-indigo-500 rounded-lg font-medium transition")
            | Request New Code
      
      div(class="mt-8 pt-8 border-t border-neutral-800 text-center")
        p(class="text-neutral-500 text-sm mb-4") Are you a creator?
        a(href="/auth/discord" class="inline-flex items-center gap-2 text-indigo-400 hover:text-indigo-300 text-sm transition")
          svg(class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor")
            path(d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z")
