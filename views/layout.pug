doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{title || 'Discord File'}
    script(src="https://cdn.tailwindcss.com")
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet")
    //- SwiperJS for TikTok-style scrolling
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css")
    script(src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js")
    //- Blurhash decoder (ESM)
    script(type="module").
      import { decode } from 'https://unpkg.com/blurhash/dist/esm/index.js';
      window.blurhashDecode = { decode };
    //- Relative time helper
    script.
      function relativeTime(date) {
        const now = new Date();
        const d = new Date(date);
        const diff = Math.floor((now - d) / 1000);
        if (diff < 60) return 'now';
        if (diff < 3600) return Math.floor(diff / 60) + 'm';
        if (diff < 86400) return Math.floor(diff / 3600) + 'h';
        if (diff < 604800) return Math.floor(diff / 86400) + 'd';
        if (diff < 2592000) return Math.floor(diff / 604800) + 'w';
        if (diff < 31536000) return Math.floor(diff / 2592000) + 'mo';
        return Math.floor(diff / 31536000) + 'y';
      }
    //- 100% privacy-first analytics
    script(data-collect-dnt="true" async src="https://sa.discordfile.site/latest.js")
    style.
      body { font-family: 'Inter', system-ui, sans-serif; }
      .masonry {
        column-count: 1;
        column-gap: 1rem;
      }
      @media (min-width: 640px) {
        .masonry { column-count: 2; }
      }
      @media (min-width: 1024px) {
        .masonry { column-count: 3; }
      }
      @media (min-width: 1280px) {
        .masonry { column-count: 4; }
      }
      .masonry-item {
        break-inside: avoid;
        margin-bottom: 1rem;
      }
      .image-card img {
        transition: transform 0.2s ease;
      }
      .image-card:hover img {
        transform: scale(1.02);
      }
      
      //- Locked premium content - blurhash canvas
      .locked-card canvas {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.85) saturate(0.8);
      }
      
      //- Filter tabs
      .filter-tab {
        background: transparent;
        color: #a3a3a3;
      }
      .filter-tab:hover {
        background: rgba(255,255,255,0.1);
      }
      .filter-tab.active {
        background: rgba(255,255,255,0.15);
        color: white;
      }
      
      //- TikTok-style swiper
      .swiper-fullscreen {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: black;
      }
      .swiper-fullscreen .swiper {
        width: 100%;
        height: 100%;
      }
      .swiper-fullscreen .swiper-slide {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100vh;
      }
      .swiper-fullscreen .slide-content {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .swiper-fullscreen .slide-content img,
      .swiper-fullscreen .slide-content video {
        max-width: 100%;
        max-height: 100vh;
        width: auto;
        height: auto;
        object-fit: contain;
      }
      .swiper-fullscreen .slide-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 2rem;
        background: linear-gradient(transparent, rgba(0,0,0,0.8));
      }
  
  body(class="min-h-screen bg-black text-white")
    //- Navbar
    block navbar
      header(class="sticky top-0 z-50 bg-black/90 backdrop-blur border-b border-neutral-800")
        div(class="container mx-auto max-w-6xl px-4 py-3 flex items-center justify-between")
          a(href="/" class="text-xl font-bold tracking-tight")
            span(class="text-white") Discord
            span(class="text-indigo-400") File
          
          div(class="flex items-center gap-4")
            if user
              a(href="/my" class="text-sm text-neutral-400 hover:text-white transition") My Files
              div(class="flex items-center gap-3")
                if user.avatar
                  img(src=`https://cdn.discordapp.com/avatars/${user.discordId}/${user.avatar}.png` alt="Avatar" class="w-8 h-8 rounded-full")
                else
                  div(class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-sm font-medium")
                    | #{user.username.charAt(0).toUpperCase()}
                a(href=`/u/${user.username}` class="text-sm font-medium hidden sm:block hover:text-indigo-400 transition") #{user.username}
                a(href="/auth/logout" class="text-sm text-neutral-400 hover:text-white transition") Logout
            else if viewer
              div(class="flex items-center gap-3")
                div(class="w-8 h-8 rounded-full bg-emerald-600 flex items-center justify-center text-sm font-medium")
                  | #{viewer.email.charAt(0).toUpperCase()}
                span(class="text-sm text-neutral-400 hidden sm:block") #{viewer.email}
                a(href="/auth/email/logout" class="text-sm text-neutral-400 hover:text-white transition") Logout
            else
              button(id="login-btn" class="inline-flex items-center gap-2 px-4 py-2 bg-orange-500 hover:bg-orange-400 rounded-lg text-sm font-medium transition")
                | Login
    
    //- Login Modal
    if !user && !viewer
      div(id="login-modal" class="fixed inset-0 z-[100] hidden")
        //- Backdrop
        div(class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="modal-backdrop")
        //- Modal content
        div(class="absolute inset-0 flex items-center justify-center p-4")
          div(class="bg-neutral-900 rounded-2xl p-6 w-full max-w-sm border border-neutral-800 shadow-2xl")
            //- Header
            div(class="text-center mb-6")
              h2(class="text-xl font-bold mb-2") Welcome
              p(class="text-neutral-400 text-sm") How would you like to continue?
            
            //- Options
            div(class="space-y-3")
              a(href="/auth/discord" class="flex items-center gap-4 p-4 bg-indigo-600 hover:bg-indigo-500 rounded-xl transition group")
                div(class="w-12 h-12 rounded-full bg-indigo-500 flex items-center justify-center group-hover:scale-110 transition")
                  svg(class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor")
                    path(d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z")
                div(class="flex-1")
                  div(class="font-semibold") Creator
                  div(class="text-indigo-200 text-sm") Upload & sell content via Discord
              
              a(href="/auth/email" class="flex items-center gap-4 p-4 bg-neutral-800 hover:bg-neutral-700 rounded-xl transition group")
                div(class="w-12 h-12 rounded-full bg-emerald-600 flex items-center justify-center group-hover:scale-110 transition")
                  svg(class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z")
                div(class="flex-1")
                  div(class="font-semibold") Viewer
                  div(class="text-neutral-400 text-sm") Browse & unlock premium content
            
            //- Close button
            button(id="modal-close" class="mt-6 w-full py-2 text-neutral-500 hover:text-white text-sm transition")
              | Cancel
      
      script.
        // Login modal
        const loginBtn = document.getElementById('login-btn');
        const loginModal = document.getElementById('login-modal');
        const modalBackdrop = document.getElementById('modal-backdrop');
        const modalClose = document.getElementById('modal-close');
        
        if (loginBtn && loginModal) {
          loginBtn.addEventListener('click', () => {
            loginModal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          });
          
          const closeModal = () => {
            loginModal.classList.add('hidden');
            document.body.style.overflow = '';
          };
          
          modalBackdrop.addEventListener('click', closeModal);
          modalClose.addEventListener('click', closeModal);
          
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !loginModal.classList.contains('hidden')) {
              closeModal();
            }
          });
        }
    
    block content
