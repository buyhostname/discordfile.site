extends layout

block content
  //- Header/Navbar
  header(class="sticky top-0 z-50 bg-black/90 backdrop-blur border-b border-neutral-800")
    div(class="container mx-auto max-w-6xl px-4 py-3 flex items-center justify-between")
      a(href="/" class="text-xl font-bold tracking-tight")
        span(class="text-white") Discord
        span(class="text-indigo-400") File

  //- Main content
  main(class="container mx-auto max-w-md px-4 py-16")
    div(class="bg-neutral-900 rounded-2xl p-8 text-center")
      //- Success icon
      div(class="w-20 h-20 mx-auto mb-6 rounded-full bg-green-500/20 flex items-center justify-center")
        svg(class="w-10 h-10 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7")
      
      h1(class="text-2xl font-bold mb-2") Payment Successful!
      p(class="text-neutral-400 mb-6")
        | You now have access to 
        if toUsername
          a(href=`/u/${toUsername}` class="text-indigo-400 hover:text-indigo-300") #{toUsername}
          | 's private content.
        else
          | the private content.
      
      //- Login prompt
      div(class="bg-neutral-800 rounded-xl p-6 mb-6")
        p(class="text-sm text-neutral-300 mb-4")
          | To view your unlocked content, log in with the email you used for payment:
        
        div(class="flex items-center justify-center gap-2 mb-4")
          code(class="bg-neutral-700 px-3 py-2 rounded-lg text-sm") #{email}
          button#copy-email(class="p-2 hover:bg-neutral-600 rounded-lg transition" data-copy=email title="Copy")
            svg(class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z")
        
        a(href=`/auth/email?prefill=${encodeURIComponent(email)}` class="block w-full py-3 bg-indigo-600 hover:bg-indigo-500 rounded-xl font-semibold transition")
          | Login with Email
      
      a(href="/" class="text-sm text-neutral-400 hover:text-white transition") Back to Home

  script.
    document.getElementById('copy-email')?.addEventListener('click', async function() {
      const text = this.dataset.copy;
      await navigator.clipboard.writeText(text);
      const svg = this.querySelector('svg');
      svg.classList.remove('text-neutral-400');
      svg.classList.add('text-green-400');
      setTimeout(() => {
        svg.classList.remove('text-green-400');
        svg.classList.add('text-neutral-400');
      }, 1000);
    });
