extends layout

block content
  //- Header/Navbar
  header(class="sticky top-0 z-50 bg-black/90 backdrop-blur border-b border-neutral-800")
    div(class="container mx-auto max-w-6xl px-4 py-3 flex items-center justify-between")
      a(href="/" class="text-xl font-bold tracking-tight")
        span(class="text-white") Discord
        span(class="text-indigo-400") File
      
      div(class="flex items-center gap-4")
        a(href="/" class="text-sm text-neutral-400 hover:text-white transition") Browse
        a(href=`/u/${user.username}` class="text-sm text-neutral-400 hover:text-white transition") My Profile
        div(class="flex items-center gap-3")
          if user.avatar
            img(src=`https://cdn.discordapp.com/avatars/${user.discordId}/${user.avatar}.png` alt="Avatar" class="w-8 h-8 rounded-full")
          else
            div(class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-sm font-medium")
              | #{user.username.charAt(0).toUpperCase()}
          span(class="text-sm font-medium hidden sm:block") #{user.username}
          a(href="/auth/logout" class="text-sm text-neutral-400 hover:text-white transition") Logout

  //- Main content
  main(class="container mx-auto max-w-6xl px-4 py-8")
    //- Page header
    div(class="flex items-center justify-between mb-8")
      div
        h1(class="text-3xl font-bold") My Images
        p(class="text-neutral-400 mt-1") Manage your uploaded images
      
      //- Settings button
      button#settings-btn(class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-sm transition")
        | Settings

    //- Stats
    div(class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8")
      div(class="bg-neutral-900 rounded-xl p-4")
        p(class="text-2xl font-bold") #{totalImages}
        p(class="text-sm text-neutral-400") Total Images
      div(class="bg-neutral-900 rounded-xl p-4")
        p(class="text-2xl font-bold") #{images.filter(i => !i.isPrivate).length}
        p(class="text-sm text-neutral-400") Public
      div(class="bg-neutral-900 rounded-xl p-4")
        p(class="text-2xl font-bold") #{images.filter(i => i.isPrivate).length}
        p(class="text-sm text-neutral-400") Private
      div(class="bg-neutral-900 rounded-xl p-4")
        p(class="text-2xl font-bold") $#{(userData.privatePrice / 100).toFixed(2)}
        p(class="text-sm text-neutral-400") Private Price

    if images && images.length > 0
      //- Instructions
      div(class="bg-neutral-900/50 border border-neutral-800 rounded-xl p-4 mb-6")
        p(class="text-sm text-neutral-400")
          | Click the lock icon to toggle privacy. Send images to the bot with the word "private" to auto-mark them as private.

      //- Image grid
      div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4")
        each image in images
          div(class="image-card group relative" data-id=image.id)
            div(class="relative rounded-xl overflow-hidden bg-neutral-900 aspect-square")
              img(
                src=image.url
                alt=image.filename
                class="w-full h-full object-cover"
                loading="lazy"
              )
              //- Privacy badge
              if image.isPrivate
                div(class="absolute top-2 left-2 px-2 py-1 bg-amber-500/90 rounded-full text-xs font-medium flex items-center gap-1")
                  svg(class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20")
                    path(fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd")
                  | Private
              
              //- Action overlay
              div(class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2")
                button(class="toggle-privacy p-2 bg-white/20 hover:bg-white/30 rounded-full transition" title="Toggle Privacy")
                  if image.isPrivate
                    svg(class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20")
                      path(fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd")
                  else
                    svg(class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20")
                      path(d="M10 2a5 5 0 00-5 5v2a2 2 0 00-2 2v5a2 2 0 002 2h10a2 2 0 002-2v-5a2 2 0 00-2-2H7V7a3 3 0 015.905-.75 1 1 0 001.937-.5A5.002 5.002 0 0010 2z")
                a(href=image.url target="_blank" class="p-2 bg-white/20 hover:bg-white/30 rounded-full transition" title="View Full")
                  svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14")
                button(class="delete-image p-2 bg-red-500/50 hover:bg-red-500/70 rounded-full transition" title="Delete")
                  svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16")

      //- Pagination
      if totalPages > 1
        nav(class="mt-8 flex justify-center gap-2")
          if page > 1
            a(href=`/my?page=${page - 1}` class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-sm transition") Previous
          
          each p in Array.from({length: Math.min(5, totalPages)}, (_, i) => Math.max(1, Math.min(totalPages - 4, page - 2)) + i)
            if p === page
              span(class="px-4 py-2 bg-indigo-600 rounded-lg text-sm font-medium") #{p}
            else
              a(href=`/my?page=${p}` class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-sm transition") #{p}
          
          if page < totalPages
            a(href=`/my?page=${page + 1}` class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-sm transition") Next

    else
      //- Empty state
      div(class="text-center py-20")
        div(class="w-24 h-24 mx-auto mb-6 rounded-full bg-neutral-900 flex items-center justify-center")
          svg(class="w-12 h-12 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z")
        h2(class="text-2xl font-bold mb-2") No images yet
        p(class="text-neutral-400 max-w-md mx-auto")
          | Send images to the Discord bot to upload them here. Add "private" in your message to mark them as private.

  //- Settings modal
  div#settings-modal(class="fixed inset-0 z-50 bg-black/80 hidden items-center justify-center")
    div(class="bg-neutral-900 rounded-2xl p-6 max-w-md w-full mx-4")
      div(class="flex items-center justify-between mb-6")
        h2(class="text-xl font-bold") Settings
        button#close-settings(class="text-neutral-400 hover:text-white")
          svg(class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")
      
      form#settings-form(class="space-y-4")
        div
          label(class="block text-sm font-medium mb-2") Bio
          textarea#bio(name="bio" rows="3" class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg focus:outline-none focus:border-indigo-500" placeholder="Tell people about yourself...")= userData.bio || ''
        
        div
          label(class="block text-sm font-medium mb-2") Private Content Price (USD)
          div(class="relative")
            span(class="absolute left-4 top-1/2 -translate-y-1/2 text-neutral-400") $
            input#privatePrice(type="number" name="privatePrice" min="1" max="100" step="0.01" value=(userData.privatePrice / 100).toFixed(2) class="w-full pl-8 pr-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg focus:outline-none focus:border-indigo-500")
          p(class="text-xs text-neutral-500 mt-1") Min $1.00, Max $100.00
        
        button(type="submit" class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 rounded-lg font-medium transition")
          | Save Settings

  script.
    // Settings modal
    const settingsBtn = document.getElementById('settings-btn');
    const settingsModal = document.getElementById('settings-modal');
    const closeSettings = document.getElementById('close-settings');
    const settingsForm = document.getElementById('settings-form');

    settingsBtn.addEventListener('click', () => {
      settingsModal.classList.remove('hidden');
      settingsModal.classList.add('flex');
    });

    closeSettings.addEventListener('click', () => {
      settingsModal.classList.add('hidden');
      settingsModal.classList.remove('flex');
    });

    settingsModal.addEventListener('click', (e) => {
      if (e.target === settingsModal) {
        settingsModal.classList.add('hidden');
        settingsModal.classList.remove('flex');
      }
    });

    settingsForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const bio = document.getElementById('bio').value;
      const privatePrice = Math.round(parseFloat(document.getElementById('privatePrice').value) * 100);
      
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bio, privatePrice })
      });
      
      if (res.ok) {
        settingsModal.classList.add('hidden');
        settingsModal.classList.remove('flex');
        location.reload();
      }
    });

    // Toggle privacy
    document.querySelectorAll('.toggle-privacy').forEach(btn => {
      btn.addEventListener('click', async () => {
        const card = btn.closest('.image-card');
        const id = card.dataset.id;
        
        const res = await fetch(`/api/images/${id}/toggle-private`, { method: 'POST' });
        if (res.ok) {
          location.reload();
        }
      });
    });

    // Delete image
    document.querySelectorAll('.delete-image').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this image?')) return;
        
        const card = btn.closest('.image-card');
        const id = card.dataset.id;
        
        const res = await fetch(`/api/images/${id}`, { method: 'DELETE' });
        if (res.ok) {
          card.remove();
        }
      });
    });
