extends layout

block content
  //- Header/Navbar
  header(class="sticky top-0 z-50 bg-black/90 backdrop-blur border-b border-neutral-800")
    div(class="container mx-auto max-w-6xl px-4 py-3 flex items-center justify-between")
      a(href="/" class="text-xl font-bold tracking-tight")
        span(class="text-white") Discord
        span(class="text-indigo-400") File
      
      div(class="flex items-center gap-4")
        if user
          a(href="/my" class="text-sm text-neutral-400 hover:text-white transition") My Images
          div(class="flex items-center gap-3")
            if user.avatar
              img(src=`https://cdn.discordapp.com/avatars/${user.discordId}/${user.avatar}.png` alt="Avatar" class="w-8 h-8 rounded-full")
            else
              div(class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-sm font-medium")
                | #{user.username.charAt(0).toUpperCase()}
            a(href=`/u/${user.username}` class="text-sm font-medium hidden sm:block hover:text-indigo-400 transition") #{user.username}
            a(href="/auth/logout" class="text-sm text-neutral-400 hover:text-white transition") Logout
        else if viewer
          div(class="flex items-center gap-3")
            div(class="w-8 h-8 rounded-full bg-emerald-600 flex items-center justify-center text-sm font-medium")
              | #{viewer.email.charAt(0).toUpperCase()}
            span(class="text-sm text-neutral-400 hidden sm:block") #{viewer.email}
            a(href="/auth/email/logout" class="text-sm text-neutral-400 hover:text-white transition") Logout
        else
          a(href="/auth/email" class="text-sm text-neutral-400 hover:text-white transition mr-2") Viewer Login
          a(href="/auth/discord" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-sm font-medium transition")
            svg(class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor")
              path(d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z")
            | Creator Login

  //- Main content
  main(class="container mx-auto max-w-3xl px-4 py-8")
    //- Hero section
    div(class="text-center mb-12")
      h1(class="text-4xl font-bold mb-4") Discover Creators
      p(class="text-xl text-neutral-400") Browse profiles and unlock exclusive content

    //- Users list
    if users && users.length > 0
      div(class="space-y-4")
        each u in users
          a(href=`/u/${u.username}` class="user-card block bg-neutral-900 hover:bg-neutral-800 rounded-xl p-4 flex items-center gap-4 transition cursor-pointer")
            //- Avatar
            div(class="flex-shrink-0")
              if u.avatar
                img(src=`https://cdn.discordapp.com/avatars/${u.discordId}/${u.avatar}.png?size=128` alt=u.username class="w-14 h-14 rounded-full object-cover ring-2 ring-neutral-700")
              else
                div(class="w-14 h-14 rounded-full bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center text-xl font-bold ring-2 ring-neutral-700")
                  | #{u.username.charAt(0).toUpperCase()}
            
            //- Info
            div(class="flex-1 min-w-0")
              h3(class="font-semibold truncate") #{u.username}
              p(class="text-sm text-neutral-400")
                | #{u.publicCount} public, #{u.privateCount} private
            
            //- Actions (pointer-events to make buttons clickable independently)
            div(class="flex items-center gap-2 flex-shrink-0 pointer-events-auto")
              span(class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-sm font-medium transition pointer-events-none")
                | View
              if u.privateCount > 0
                if u.hasUnlocked
                  span(class="px-4 py-2 bg-gradient-to-r from-emerald-500 to-green-500 rounded-lg text-sm font-medium pointer-events-none")
                    | Premium
                else
                  button(class="pay-btn px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 rounded-lg text-sm font-medium transition pointer-events-auto" data-user-id=u.id data-price=u.privatePrice)
                    | Unlock $#{(u.privatePrice / 100).toFixed(2)}
    else
      //- Empty state
      div(class="text-center py-20")
        div(class="w-24 h-24 mx-auto mb-6 rounded-full bg-neutral-900 flex items-center justify-center")
          svg(class="w-12 h-12 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z")
        h2(class="text-2xl font-bold mb-2") No users yet
        p(class="text-neutral-400 mb-6") Be the first to join!
        if !user
          a(href="/auth/discord" class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 hover:bg-indigo-500 rounded-xl font-medium transition")
            | Login with Discord

  //- Footer
  footer(class="border-t border-neutral-800 mt-20")
    div(class="container mx-auto max-w-6xl px-4 py-8 text-center text-neutral-500 text-sm")
      | Discord File

  script.
    document.querySelectorAll('.pay-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        btn.disabled = true;
        btn.textContent = 'Loading...';
        
        const userId = btn.dataset.userId;
        const res = await fetch(`/api/pay/${userId}`, { method: 'POST' });
        const data = await res.json();
        
        if (data.url) {
          window.location.href = data.url;
        } else {
          alert(data.error || 'Payment failed');
          btn.disabled = false;
          btn.textContent = `Unlock $${(parseInt(btn.dataset.price) / 100).toFixed(2)}`;
        }
      });
    });
