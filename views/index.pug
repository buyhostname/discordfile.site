extends layout

block content
  //- Header/Navbar
  header(class="sticky top-0 z-50 bg-black/90 backdrop-blur border-b border-neutral-800")
    div(class="container mx-auto max-w-6xl px-4 py-3 flex items-center justify-between")
      a(href="/" class="text-xl font-bold tracking-tight")
        span(class="text-white") Discord
        span(class="text-indigo-400") File
      
      div(class="flex items-center gap-4")
        if user
          div(class="flex items-center gap-3")
            if user.avatar
              img(src=`https://cdn.discordapp.com/avatars/${user.discordId}/${user.avatar}.png` alt="Avatar" class="w-8 h-8 rounded-full")
            else
              div(class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-sm font-medium")
                | #{user.username.charAt(0).toUpperCase()}
            span(class="text-sm font-medium hidden sm:block") #{user.username}
            a(href="/auth/logout" class="text-sm text-neutral-400 hover:text-white transition")
              | Logout
        else
          a(href="/auth/discord" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-sm font-medium transition")
            svg(class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor")
              path(d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z")
            | Login with Discord

  //- Main content
  main(class="container mx-auto max-w-6xl px-4 py-8")
    if user
      if images && images.length > 0
        //- Stats bar
        div(class="mb-6 flex items-center justify-between")
          div(class="text-neutral-400 text-sm")
            span(class="text-white font-semibold") #{totalImages}
            |  images uploaded
          if totalPages > 1
            div(class="text-neutral-400 text-sm")
              | Page #{page} of #{totalPages}
        
        //- Image grid (Instagram-style masonry)
        div(class="masonry")
          each image in images
            div(class="masonry-item image-card")
              div(class="relative group rounded-xl overflow-hidden bg-neutral-900")
                a(href=image.url target="_blank" rel="noopener")
                  img(
                    src=image.url
                    alt=image.filename
                    class="w-full h-auto"
                    loading="lazy"
                  )
                //- Overlay on hover
                div(class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-end")
                  div(class="p-4 w-full")
                    p(class="text-sm font-medium truncate") #{image.filename}
                    p(class="text-xs text-neutral-400 mt-1")
                      | #{new Date(image.createdAt).toLocaleDateString()}
        
        //- Pagination
        if totalPages > 1
          nav(class="mt-8 flex justify-center gap-2")
            if page > 1
              a(href=`/?page=${page - 1}` class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-sm transition")
                | Previous
            
            - var startPage = Math.max(1, page - 2)
            - var endPage = Math.min(totalPages, page + 2)
            
            each p in Array.from({length: endPage - startPage + 1}, (_, i) => startPage + i)
              if p === page
                span(class="px-4 py-2 bg-indigo-600 rounded-lg text-sm font-medium") #{p}
              else
                a(href=`/?page=${p}` class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-sm transition") #{p}
            
            if page < totalPages
              a(href=`/?page=${page + 1}` class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-sm transition")
                | Next
      
      else
        //- Empty state
        div(class="text-center py-20")
          div(class="w-24 h-24 mx-auto mb-6 rounded-full bg-neutral-900 flex items-center justify-center")
            svg(class="w-12 h-12 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z")
          h2(class="text-2xl font-bold mb-2") No images yet
          p(class="text-neutral-400 max-w-md mx-auto mb-6")
            | Upload images by sending them directly to the 
            span(class="text-indigo-400 font-medium") file.site
            |  bot on Discord. The bot will automatically save them here!
          div(class="bg-neutral-900 rounded-xl p-6 max-w-md mx-auto text-left")
            h3(class="font-semibold mb-3") How to upload:
            ol(class="text-sm text-neutral-400 space-y-2")
              li(class="flex items-start gap-2")
                span(class="text-indigo-400 font-medium") 1.
                | DM the bot or mention it in a server where it's added
              li(class="flex items-start gap-2")
                span(class="text-indigo-400 font-medium") 2.
                | Send any image attachments
              li(class="flex items-start gap-2")
                span(class="text-indigo-400 font-medium") 3.
                | The bot reacts with a checkmark when saved
              li(class="flex items-start gap-2")
                span(class="text-indigo-400 font-medium") 4.
                | Refresh this page to see your images!
    
    else
      //- Not logged in
      div(class="text-center py-20")
        div(class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center")
          svg(class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 24 24")
            path(d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z")
        h1(class="text-4xl font-bold mb-4") Discord File
        p(class="text-xl text-neutral-400 max-w-lg mx-auto mb-8")
          | Upload images via Discord, view them in a beautiful Instagram-style feed
        a(href="/auth/discord" class="inline-flex items-center gap-3 px-6 py-3 bg-indigo-600 hover:bg-indigo-500 rounded-xl text-lg font-medium transition")
          svg(class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor")
            path(d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z")
          | Login with Discord
        
        //- Features
        div(class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto")
          div(class="text-center")
            div(class="w-14 h-14 mx-auto mb-4 rounded-xl bg-neutral-900 flex items-center justify-center")
              svg(class="w-7 h-7 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12")
            h3(class="font-semibold mb-2") Easy Upload
            p(class="text-sm text-neutral-400") Just send images to the Discord bot - no forms, no buttons
          
          div(class="text-center")
            div(class="w-14 h-14 mx-auto mb-4 rounded-xl bg-neutral-900 flex items-center justify-center")
              svg(class="w-7 h-7 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z")
            h3(class="font-semibold mb-2") Beautiful Gallery
            p(class="text-sm text-neutral-400") View your images in a clean, modern feed layout
          
          div(class="text-center")
            div(class="w-14 h-14 mx-auto mb-4 rounded-xl bg-neutral-900 flex items-center justify-center")
              svg(class="w-7 h-7 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z")
            h3(class="font-semibold mb-2") Private & Secure
            p(class="text-sm text-neutral-400") Only you can see your uploaded images

  //- Lightbox modal (for clicking images)
  div#lightbox(class="fixed inset-0 z-50 bg-black/95 hidden items-center justify-center cursor-zoom-out")
    img#lightbox-img(class="max-w-full max-h-full object-contain")
    button#lightbox-close(class="absolute top-4 right-4 text-white/60 hover:text-white")
      svg(class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")

  script.
    // Lightbox functionality
    document.querySelectorAll('.image-card a').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const lightbox = document.getElementById('lightbox');
        const img = document.getElementById('lightbox-img');
        img.src = link.href;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
      });
    });
    
    document.getElementById('lightbox').addEventListener('click', () => {
      const lightbox = document.getElementById('lightbox');
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    });
    
    document.getElementById('lightbox-close').addEventListener('click', () => {
      const lightbox = document.getElementById('lightbox');
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    });
    
    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const lightbox = document.getElementById('lightbox');
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
      }
    });
