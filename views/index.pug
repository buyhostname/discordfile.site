extends layout

block content

  //- Main content
  main(class="container mx-auto max-w-3xl px-4 py-8")
    //- Hero section
    div(class="text-center mb-12")
      h1(class="text-4xl font-bold mb-4") Discover Creators
      p(class="text-xl text-neutral-400") Creators upload via Discord/DM. Users see uploaded content here.

    //- Users list
    if users && users.length > 0
      div(class="space-y-4")
        each u in users
          a(href=`/u/${u.username}` class="user-card block bg-neutral-900 hover:bg-neutral-800 rounded-xl p-4 transition cursor-pointer")
            div(class="flex items-center gap-4")
              //- Avatar
              div(class="flex-shrink-0")
                if u.avatar
                  img(src=`https://cdn.discordapp.com/avatars/${u.discordId}/${u.avatar}.png?size=128` alt=u.username class="w-12 h-12 rounded-full object-cover ring-2 ring-neutral-700")
                else
                  div(class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center text-lg font-bold ring-2 ring-neutral-700")
                    | #{u.username.charAt(0).toUpperCase()}
              
              //- Info
              div(class="flex-1 min-w-0")
                h3(class="font-semibold truncate") #{u.username}
                p(class="text-sm text-neutral-400")
                  | #{u.publicCount} public, #{u.privateCount} premium
            
            //- Actions
            div(class="flex items-center gap-2 mt-3 pointer-events-auto")
              span(class="flex-1 text-center px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-sm font-medium transition pointer-events-none")
                | View
              if u.privateCount > 0
                if u.hasUnlocked
                  span(class="flex-1 text-center px-4 py-2 bg-gradient-to-r from-emerald-500 to-green-500 rounded-lg text-sm font-medium pointer-events-none")
                    | Unlocked
                else
                  button(class="pay-btn flex-1 px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 rounded-lg text-sm font-medium transition pointer-events-auto" data-user-id=u.id data-price=u.privatePrice)
                    | Unlock $#{(u.privatePrice / 100).toFixed(2)}
    else
      //- Empty state
      div(class="text-center py-20")
        div(class="w-24 h-24 mx-auto mb-6 rounded-full bg-neutral-900 flex items-center justify-center")
          svg(class="w-12 h-12 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z")
        h2(class="text-2xl font-bold mb-2") No users yet
        p(class="text-neutral-400 mb-6") Be the first to join!
        if !user
          a(href="/auth/discord" class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 hover:bg-indigo-500 rounded-xl font-medium transition")
            | Login with Discord

  //- Footer
  footer(class="border-t border-neutral-800 mt-20")
    div(class="container mx-auto max-w-6xl px-4 py-8 text-center text-neutral-500 text-sm")
      p(class="mb-4") Discord File
      div(class="max-w-md mx-auto text-xs text-neutral-600 space-y-1")
        p Upload via Discord DM or server. Add keywords to your message:
        p
          span(class="text-amber-500/80") private
          |  — premium content &nbsp;
          span(class="text-indigo-400/80") mute
          |  — strip audio from video

  script.
    // Payment buttons
    document.querySelectorAll('.pay-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        btn.disabled = true;
        btn.textContent = 'Loading...';
        
        const userId = btn.dataset.userId;
        const res = await fetch(`/api/pay/${userId}`, { method: 'POST' });
        const data = await res.json();
        
        if (data.url) {
          window.location.href = data.url;
        } else {
          alert(data.error || 'Payment failed');
          btn.disabled = false;
          btn.textContent = `Unlock $${(parseInt(btn.dataset.price) / 100).toFixed(2)}`;
        }
      });
    });
