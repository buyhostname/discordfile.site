extends layout

block content
  //- Main content
  main(class="container mx-auto max-w-6xl px-4 py-8")
    //- Profile header
    div(class="flex flex-col md:flex-row items-center md:items-start gap-6 mb-10")
      //- Avatar
      div(class="w-32 h-32 flex-shrink-0")
        if profileUser.avatar
          img(src=`https://cdn.discordapp.com/avatars/${profileUser.discordId}/${profileUser.avatar}.png?size=256` alt=profileUser.username class="w-full h-full rounded-full object-cover ring-4 ring-neutral-800")
        else
          div(class="w-full h-full rounded-full bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center text-4xl font-bold ring-4 ring-neutral-800")
            | #{profileUser.username.charAt(0).toUpperCase()}
      
      //- Info
      div(class="text-center md:text-left flex-1")
        h1(class="text-3xl font-bold") #{profileUser.username}
        if profileUser.bio
          p(class="text-neutral-400 mt-2 max-w-xl") #{profileUser.bio}
        
        - var publicCount = allContent.filter(c => !c.isPrivate).length
        div(class="flex items-center justify-center md:justify-start gap-6 mt-4 text-sm")
          div
            span(class="font-semibold") #{allContent.length}
            span(class="text-neutral-400 ml-1") total
          div
            span(class="font-semibold") #{publicCount}
            span(class="text-neutral-400 ml-1") public
          if privateCount > 0
            div
              span(class="font-semibold text-amber-400") #{privateCount}
              span(class="text-neutral-400 ml-1") premium
        
        //- Unlock button in header if has premium content and not unlocked
        if privateCount > 0 && !isOwner && !hasAccess
          button(class="unlock-btn mt-4 px-6 py-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 rounded-lg font-semibold transition inline-flex items-center gap-2" data-user-id=profileUser.id)
            svg(class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20")
              path(fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd")
            | Unlock All - $#{(profileUser.privatePrice / 100).toFixed(2)}
        
        if isOwner
          a(href="/my" class="inline-block mt-4 px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-sm transition")
            | Edit Profile

    //- Filter tabs
    - var publicCount = allContent.filter(c => !c.isPrivate).length
    if allContent.length > 0
      div(class="flex items-center gap-2 mb-6")
        button(class="filter-tab active px-4 py-2 rounded-lg text-sm font-medium transition" data-filter="all")
          | All
          span(class="ml-1.5 px-1.5 py-0.5 bg-white/10 rounded text-xs") #{allContent.length}
        button(class="filter-tab px-4 py-2 rounded-lg text-sm font-medium transition" data-filter="public")
          | Public
          span(class="ml-1.5 px-1.5 py-0.5 bg-white/10 rounded text-xs") #{publicCount}
        button(class="filter-tab px-4 py-2 rounded-lg text-sm font-medium transition" data-filter="premium")
          | Premium
          span(class="ml-1.5 px-1.5 py-0.5 bg-amber-500/20 text-amber-400 rounded text-xs") #{privateCount}

    //- Content grid (sorted by date, newest first)
    if allContent.length > 0
      div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4" id="content-grid")
        each item, index in allContent
          - var mediaUrl = '/file/' + item.id
          - var previewUrl = '/preview/' + item.id
          - var isVideo = item.contentType && item.contentType.startsWith('video/')
          - var isImage = item.contentType && item.contentType.startsWith('image/')
          - var isAudio = item.contentType && item.contentType.startsWith('audio/')
          - var isLocked = item.isPrivate && !isOwner && !hasAccess
          - var isMediaItem = isImage || isVideo
          - var contentType = item.isPrivate ? 'premium' : 'public'
          
          if isMediaItem
              if isLocked
                //- Locked premium content - show blurhash with unlock overlay
                div(class="content-item image-card group cursor-pointer locked-card" data-user-id=profileUser.id data-preview-id=item.id data-content-type="premium")
                  div(class="relative rounded-xl overflow-hidden bg-neutral-900 aspect-square")
                    //- Blurhash canvas (will be rendered by JS)
                    canvas(class="blurhash-canvas w-full h-full" data-preview-id=item.id)
                    
                    //- Lock overlay
                    div(class="absolute inset-0 bg-black/30 flex flex-col items-center justify-center")
                      div(class="w-12 h-12 rounded-full bg-amber-500/90 flex items-center justify-center mb-2")
                        svg(class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20")
                          path(fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd")
                      span(class="text-xs font-medium text-white/90") Premium
                    
                    //- Time badge
                    span(class="absolute bottom-2 left-2 px-1.5 py-0.5 bg-black/60 rounded text-xs text-white/80 time-badge" data-time=item.createdAt.toISOString())
                    
                    //- Video badge if it's a video
                    if isVideo
                      div(class="absolute top-2 right-2 px-2 py-1 bg-black/70 rounded-full text-xs font-medium flex items-center gap-1")
                        svg(class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20")
                          path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd")
                        | Video
              else
                //- Unlocked content (public or has access)
                a(href=`/view/${profileUser.username}?start=${index}` class="content-item image-card group block cursor-pointer" data-content-type=contentType)
                  div(class="relative rounded-xl overflow-hidden bg-neutral-900 aspect-square")
                    if isVideo
                      video(
                        src=mediaUrl
                        class="w-full h-full object-cover"
                        muted
                        loop
                        playsinline
                        onmouseenter="this.play()"
                        onmouseleave="this.pause(); this.currentTime=0;"
                      )
                    else
                      img(src=mediaUrl alt=item.filename class="w-full h-full object-cover" loading="lazy")
                    
                    //- Type badge
                    if isVideo
                      div(class="absolute top-2 right-2 px-2 py-1 bg-black/70 rounded-full text-xs font-medium flex items-center gap-1")
                        svg(class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20")
                          path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd")
                        | Video
                    
                    //- Premium badge for unlocked premium content
                    if item.isPrivate
                      div(class="absolute top-2 left-2 px-2 py-1 bg-amber-500/90 rounded-full text-xs font-medium flex items-center gap-1")
                        svg(class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20")
                          path(fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd")
                        | Premium
                    
                    //- Time badge
                    span(class="absolute bottom-2 left-2 px-1.5 py-0.5 bg-black/60 rounded text-xs text-white/80 time-badge" data-time=item.createdAt.toISOString())
                    
                    //- Hover overlay with description
                    div(class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end")
                      if item.description
                        div(class="p-3 text-sm")
                          p(class="line-clamp-2") #{item.description}
          else
            //- Non-media files (audio, documents, etc.)
            if isLocked
              div(class="content-item image-card group cursor-pointer locked-card" data-user-id=profileUser.id data-content-type="premium")
                div(class="relative rounded-xl overflow-hidden bg-neutral-900 aspect-square")
                  div(class="w-full h-full flex flex-col items-center justify-center p-4 text-center bg-neutral-800")
                    div(class="w-12 h-12 rounded-full bg-amber-500/90 flex items-center justify-center mb-2")
                      svg(class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20")
                        path(fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd")
                    span(class="text-xs text-neutral-400") Premium File
                  if isAudio
                    div(class="absolute top-2 right-2 px-2 py-1 bg-purple-500/70 rounded-full text-xs font-medium")
                      | Audio
                  else
                    div(class="absolute top-2 right-2 px-2 py-1 bg-neutral-700/70 rounded-full text-xs font-medium")
                      | File
            else
              a(href=mediaUrl download=item.filename class="content-item image-card group block cursor-pointer" data-content-type=contentType)
                div(class="relative rounded-xl overflow-hidden bg-neutral-900 aspect-square")
                  div(class="w-full h-full flex flex-col items-center justify-center p-4 text-center")
                    if isAudio
                      svg(class="w-12 h-12 text-purple-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3")
                    else
                      svg(class="w-12 h-12 text-neutral-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z")
                    span(class="text-xs text-neutral-400 truncate w-full") #{item.filename}
                  if isAudio
                    div(class="absolute top-2 right-2 px-2 py-1 bg-purple-500/70 rounded-full text-xs font-medium")
                      | Audio
                  else
                    div(class="absolute top-2 right-2 px-2 py-1 bg-neutral-700/70 rounded-full text-xs font-medium")
                      | File
                  if item.isPrivate
                    div(class="absolute top-2 left-2 px-2 py-1 bg-amber-500/90 rounded-full text-xs font-medium")
                      | Premium
                  div(class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center")
                    div(class="p-3 bg-white/20 rounded-full")
                      svg(class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4")
    else
      //- Empty state
      div(class="text-center py-20")
        div(class="w-24 h-24 mx-auto mb-6 rounded-full bg-neutral-900 flex items-center justify-center")
          svg(class="w-12 h-12 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z")
        h2(class="text-2xl font-bold mb-2") No content yet
        p(class="text-neutral-400")
          | #{profileUser.username} hasn't uploaded anything yet.

  script.
    // Wait for blurhash module to load, then render
    function waitForBlurhash(callback) {
      if (window.blurhashDecode) {
        callback();
      } else {
        setTimeout(() => waitForBlurhash(callback), 50);
      }
    }
    
    // Render blurhash to canvas
    async function renderBlurhash(canvas, previewId) {
      try {
        const res = await fetch(`/preview/${previewId}`);
        const data = await res.json();
        if (!data.blurhash) return;
        
        const width = 256;
        const height = 256;
        const pixels = blurhashDecode.decode(data.blurhash, width, height);
        
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        const imageData = ctx.createImageData(width, height);
        imageData.data.set(pixels);
        ctx.putImageData(imageData, 0, 0);
      } catch (err) {
        console.error('Blurhash render error:', err);
      }
    }
    
    // Render all blurhash canvases once module is loaded
    waitForBlurhash(() => {
      document.querySelectorAll('.blurhash-canvas').forEach(canvas => {
        renderBlurhash(canvas, canvas.dataset.previewId);
      });
    });
    
    // Unlock button handlers (for both header button and locked cards)
    async function handleUnlock(userId) {
      const res = await fetch(`/api/pay/${userId}`, { method: 'POST' });
      const data = await res.json();
      
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert(data.error || 'Payment failed');
      }
    }
    
    // Header unlock button
    document.querySelectorAll('.unlock-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.innerHTML = '<span>Loading...</span>';
        await handleUnlock(btn.dataset.userId);
      });
    });
    
    // Locked card click handlers
    document.querySelectorAll('.locked-card').forEach(card => {
      card.addEventListener('click', async () => {
        await handleUnlock(card.dataset.userId);
      });
    });
    
    // Filter tabs
    document.querySelectorAll('.filter-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        // Update active state
        document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        
        // Filter content
        const filter = tab.dataset.filter;
        document.querySelectorAll('.content-item').forEach(item => {
          if (filter === 'all' || item.dataset.contentType === filter) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
    
    // Populate relative time badges
    document.querySelectorAll('.time-badge').forEach(el => {
      el.textContent = relativeTime(el.dataset.time);
    });
