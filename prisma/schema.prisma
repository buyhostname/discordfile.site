generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Creators - users who upload via Discord
model User {
  id              String    @id @default(cuid())
  discordId       String    @unique
  username        String
  discriminator   String?
  email           String?
  avatar          String?
  bio             String?
  privatePrice    Int       @default(500) // Price in cents ($5.00 default)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  images          Image[]
  paymentsReceived Payment[] @relation("PaymentTo")
}

// Viewers - users who pay to view content (login via email)
model Viewer {
  id              String    @id @default(cuid())
  email           String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  payments        Payment[] @relation("PaymentFrom")
}

model Image {
  id          String   @id @default(cuid())
  url         String
  proxyUrl    String?
  filename    String
  description String?
  contentType String?
  width       Int?
  height      Int?
  size        Int?
  messageId   String
  channelId   String
  guildId     String?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([isPrivate])
}

model Payment {
  id                String   @id @default(cuid())
  stripePaymentId   String   @unique
  stripeSessionId   String?
  email             String   // Email used for payment
  amount            Int      // in cents
  status            String   @default("pending") // pending, completed, failed
  createdAt         DateTime @default(now())
  
  // Viewer who paid (optional - created after payment)
  viewerId          String?
  viewer            Viewer?  @relation("PaymentFrom", fields: [viewerId], references: [id], onDelete: SetNull)
  
  // Creator they paid to see
  toUserId          String
  toUser            User     @relation("PaymentTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([viewerId])
  @@index([toUserId])
  @@index([status])
  @@index([email])
}

// Email login tokens
model LoginToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  otp       String?  // 6-character OTP code
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0) // Track failed OTP attempts (max 2)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}
