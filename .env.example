# ===========================================
# Discord File - Environment Configuration
# ===========================================

# Server port (default: 3000)
PORT=3000

# Set to "true" in production for secure cookies
PRODUCTION=true

# ===========================================
# Discord OAuth & Bot
# Get these from: https://discord.com/developers/applications
# 1. Create a new application
# 2. Go to "OAuth2" tab for Client ID and Client Secret
# 3. Go to "Bot" tab, click "Add Bot", then "Reset Token" to get the bot token
# 4. Enable "Message Content Intent" under Bot > Privileged Gateway Intents
# ===========================================

# Found in OAuth2 > General
DISCORD_CLIENT_ID=

# Found in OAuth2 > General (click "Reset Secret" if needed)
DISCORD_CLIENT_SECRET=

# OAuth callback URL - set this in Discord OAuth2 > Redirects
# Format: https://yourdomain.com/auth/discord/callback
DISCORD_REDIRECT_URI=

# Found in Bot tab (click "Reset Token" to generate)
DISCORD_BOT_TOKEN=

# Auto-generated bot invite link (created on first run if empty)
DISCORD_BOT_INVITE=

# ===========================================
# Session
# ===========================================

# Random string for session encryption (generate with: openssl rand -hex 32)
SESSION_SECRET=

# ===========================================
# Database
# SQLite file path (relative to project root)
# ===========================================

DATABASE_URL="file:./dev.db"

# ===========================================
# Stripe Payments
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production
# ===========================================

# Found in Stripe Dashboard > Developers > API keys > Publishable key
STRIPE_PUBLISHABLE_KEY=

# Found in Stripe Dashboard > Developers > API keys > Secret key
STRIPE_SECRET_KEY=

# Webhook signing secret (created via Stripe CLI)
STRIPE_WEBHOOK_SECRET=

# ===========================================
# Email (Resend)
# Get API key from: https://resend.com/api-keys
# On hoston.ai: Settings > Integrations > Resend
# ===========================================

# Resend API key (starts with re_)
RESEND_API_KEY=

# Sender email address (must be verified in Resend)
# Format: Name <email@yourdomain.com>
EMAIL_FROM=
